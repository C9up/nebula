{
  "name": "@c9up/nebula",
  "version": "0.1.8",
  "description": "Nebula — shadcn/ui ported to Aurora, organised as atomic design. Zero-dependency headless primitives, cva reimplemented, copy-the-source registry.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./lib": {
      "types": "./src/lib/index.ts",
      "import": "./src/lib/index.ts"
    },
    "./primitives": {
      "types": "./src/primitives/index.ts",
      "import": "./src/primitives/index.ts"
    },
    "./atoms": {
      "types": "./src/atoms/index.ts",
      "import": "./src/atoms/index.ts"
    },
    "./molecules": {
      "types": "./src/molecules/index.ts",
      "import": "./src/molecules/index.ts"
    },
    "./organisms": {
      "types": "./src/organisms/index.ts",
      "import": "./src/organisms/index.ts"
    },
    "./templates": {
      "types": "./src/templates/index.ts",
      "import": "./src/templates/index.ts"
    },
    "./registry.json": "./registry.json",
    "./theme.css": "./theme.css",
    "./nebula.css": "./nebula.css",
    "./package.json": "./package.json",
    "./configure": {
      "types": "./src/configure.ts",
      "import": "./src/configure.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "import": "./src/cli/index.ts"
    },
    "./commands/add": {
      "types": "./src/console/AddCommand.ts",
      "import": "./src/console/AddCommand.ts"
    },
    "./commands/list": {
      "types": "./src/console/ListCommand.ts",
      "import": "./src/console/ListCommand.ts"
    },
    "./commands/diff": {
      "types": "./src/console/DiffCommand.ts",
      "import": "./src/console/DiffCommand.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check src/ tests/",
    "test:coverage": "vitest run --coverage",
    "registry": "node --experimental-strip-types scripts/build-registry.ts",
    "css": "node --experimental-strip-types scripts/build-css.ts",
    "prepublishOnly": "pnpm registry && pnpm css && pnpm build"
  },
  "peerDependencies": {
    "@c9up/aurora": "^0.1.30",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependenciesMeta": {
