      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "import": "./dist/cli/index.js"
      },
      "./commands/add": {
        "types": "./dist/console/AddCommand.d.ts",
        "import": "./dist/console/AddCommand.js"
      },
      "./commands/list": {
        "types": "./dist/console/ListCommand.d.ts",
        "import": "./dist/console/ListCommand.js"
