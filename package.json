    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.11"
  },
  "files": [
    "LICENSE",
